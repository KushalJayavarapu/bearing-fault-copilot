# Copy this file to .env and fill in real values. Never commit .env.
# Names may change; Kushal owns this file. Announce changes in the team chat.

# LLM server: AMD Token Factory. Only the key is secret, ask nobody for it: reveal it on your own Token Factory page.
# The model catalog changes, so check GET <base url>/models if a call says the model is not supported.
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_API_KEY=replace-me
LLM_MODEL=DeepSeek-V4-Flash
# Shown in each answer's meta.served_on. Set it to what really serves the model, e.g. AMD Token Factory.
LLM_SERVED_ON=AMD Token Factory (AMD Radeon GPUs)
# Calls to the LLM at the same time from this app. The whole team shares ONE key, so keep this small.
LLM_MAX_CONCURRENT=2
# With MOCK_MODE=true: LLM_MOCK=false keeps sensor and retrieval mock but gets the explanation from the real LLM.
LLM_MOCK=true

# Return mock data from every part (no models, no data needed)
MOCK_MODE=true

# Backend API
API_HOST=0.0.0.0
API_PORT=8080
