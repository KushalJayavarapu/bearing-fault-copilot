# Copy this file to .env and fill in real values. Never commit .env.
# Names may change; Kushal owns this file. Announce changes in the team chat.

# LLM server: AMD Token Factory. Only the key is secret, ask nobody for it: reveal it on your own Token Factory page.
# The model catalog changes, so check GET <base url>/models if a call says the model is not supported.
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_API_KEY=replace-me
LLM_MODEL=DeepSeek-V4-Flash
# Shown in each answer's meta.served_on. Set it to what really serves the model, e.g. AMD Token Factory.
LLM_SERVED_ON=AMD Token Factory (AMD Radeon GPUs)
# Calls to the LLM at the same time from this app. The whole team shares ONE key, so keep this small.
LLM_MAX_CONCURRENT=2
# With MOCK_MODE=true: LLM_MOCK=false keeps sensor and retrieval mock but gets the explanation from the real LLM.
LLM_MOCK=true

# true = canned sensor data and stub retrieval (no models, no data needed).
# false = the real classifier and retrieval: see app/README.md, "Real sensor and retrieval".
MOCK_MODE=true

# Backend API. 127.0.0.1 keeps it on your computer (and gives a link the browser can open). The Docker image sets 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8080
LOG_LEVEL=INFO

# Streamlit UI
UI_PORT=8501

# URL the UI uses to reach the API (inside Docker Compose: http://api:8080)
API_URL=http://localhost:8080

# Retriever mode: "real" requires a built RAG index (rag/index/); "mock" uses canned passages
RETRIEVER_MODE=mock

# Generic port variable — hosting platforms (Render, Railway) set this.
# Falls back to API_PORT if not set.
# PORT=8080

# Fake key for local testing (48-zero placeholder). Replace with your real key in .env.
# LLM_API_KEY=rc-000000000000000000000000000000000000000000000000

