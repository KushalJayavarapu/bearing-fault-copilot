# Copy to app/ui/.env. MOCK=true shows built-in demo data and needs no backend.
# MOCK=false talks to the API (python -m app) at API_URL.
MOCK=false
API_URL=http://localhost:8080
# Real mode shows only the 10 held-out recordings (3 hp) that the demo classifier never trained on.
# true = show all 40, including recordings it trained on (the results then look better than they are).
ALL_RECORDINGS=false
